// midular_core.jsfx-inc
// Midular - MIDI sampler for REAPER.
// Core layer: memory map, math helpers, source-data loading and slice analysis.
//
// This file only defines functions (per JSFX import rules, statements placed in
// an imported @init section are not guaranteed to run).  All of the actual
// initialisation happens in Midular.jsfx.
//
// Copyright (C) 2026  Midular contributors.  Licensed under the GPL v3.

@init

// ---------------------------------------------------------------------------
// Memory map / constants
// ---------------------------------------------------------------------------
function md_init_consts()
(
  MD_MAGIC      = 7473;       // magic number expected as first record of a .txt source
  MD_FMT_VER    = 1;

  MAX_NOTES     = 32768;
  NOTE_STRIDE   = 5;          // start(beats), len(beats), pitch, velocity, channel
  BUF_NOTES     = 0;          // .. 163840

  ORD_FWD       = 200000;     // note indices sorted by forward key
  ORD_REV       = 240000;     // note indices sorted by reverse (mirrored) key
  KEY_FWD       = 280000;     // KEY_FWD[i]  = start(i)
  KEY_REV       = 320000;     // KEY_REV[i]  = srclen - (start(i) + len(i))

  MAX_MARKERS   = 256;
  MARKERS       = 360000;     // live marker list (source beats, kept sorted)
  MARKERS_SV    = 360500;     // markers as stored in the project (@serialize)

  MAX_SLICES    = 128;
  SLICES        = 361000;     // stride 2: [startBeat, endBeat]

  MAX_VOICES    = 16;
  MAX_GRAINS    = 256;
  S_STRIDE      = 16;
  STREAMS       = 362000;     // (MAX_VOICES + MAX_GRAINS) * S_STRIDE
  // stream fields
  S_ACTIVE      = 0;
  S_POS         = 1;          // current position on the virtual timeline (beats)
  S_EVI         = 2;          // index into the active order array
  S_DIR         = 3;          // +1 forward, -1 reversed
  S_SEGA        = 4;          // loop return point (virtual beats)
  S_SEGB        = 5;          // end of segment    (virtual beats)
  S_RATE        = 6;          // virtual beats per sample (always >= 0)
  S_LOOPS       = 7;          // completed loop passes
  S_OWNER       = 8;          // owning voice index
  S_TRANSP      = 9;          // extra transpose (grains)
  S_VELSC       = 10;         // extra velocity scale (grains)
  S_ENDSMP      = 11;         // absolute sample at which the stream expires (0 = never)
  S_LOOPEN      = 12;         // 1 if the segment loops
  S_LOOPMODE    = 13;         // 0 fwd, 1 rev, 2 ping-pong
  S_GRAIN       = 14;         // 1 if this stream belongs to a grain

  V_STRIDE      = 32;
  VOICES        = 368000;
  V_STATE       = 0;          // 0 free, 1 held, 2 releasing
  V_KEY         = 1;
  V_VEL         = 2;
  V_CHAN        = 3;
  V_STARTSMP    = 4;          // absolute sample the voice starts sounding
  V_RELSMP      = 5;
  V_RELLVL      = 6;
  V_TRANSP      = 7;
  V_RATESC      = 8;
  V_STREAM      = 9;          // stream index used by non-granular modes
  V_NGRAIN      = 10;
  V_AGE         = 11;
  V_SLICE       = 12;
  V_GNEXT       = 13;         // next grain spawn (absolute samples)
  V_GIDX        = 14;         // rotating grain slot
  V_RNG         = 15;         // per-voice RNG state
  V_ALIVE       = 16;         // 1 while any stream of this voice is still running
  V_SEGA        = 17;         // voice segment bounds in source beats (for grains / UI)
  V_SEGB        = 18;
  V_DIR         = 19;
  V_RATE        = 20;
  V_GBASE       = 21;         // first grain slot owned by this voice
  V_MODE        = 22;         // mode captured at trigger time
  V_SUSHOLD     = 23;         // note-off arrived while the sustain pedal was down
  V_HOLD        = 24;         // 1 if note-off is ignored (one-shot, slice "until end")

  G_STRIDE      = 8;
  GRAINS        = 369000;
  G_OWNER       = 0;          // owning voice + 1 (0 = free)
  G_BIRTH       = 1;          // absolute sample the current grain cycle started
  G_LIFE        = 2;          // length of the cycle (grain length / density)
  G_ALT         = 3;          // alternating-direction flip-flop

  MAX_SOUND     = 512;
  N_STRIDE      = 4;
  SOUND         = 372000;     // [key, offSample, owner, used]
  N_KEY         = 0;
  N_OFF         = 1;
  N_OWNER       = 2;
  N_USED        = 3;
  SOUNDMAP      = 375000;     // 2048 entries: chan*128+pitch -> slot+1

  // note-ons that fall in a later block (humanize can push a note past the end
  // of the current one); fired by md_pend_flush() when their block comes round
  MAX_PEND      = 256;
  P_STRIDE      = 6;
  PEND          = 382000;     // [time, chan, pitch, vel, dur, owner]

  MAX_CTLS      = 224;
  C_STRIDE      = 16;
  CTLS          = 378000;

  SCRATCH       = 390000;     // MAX_NOTES scratch for sorting keys

  // ---- phrase blocks ------------------------------------------------------
  // A phrase travels as a "phrase block": the same layout in gmem (from the
  // importer), in STAGE (waiting for @block to install it) and in CURHDR (the
  // header of the phrase now playing, whose notes live in BUF_NOTES).
  // scripts/midular_import.lua mirrors these offsets - change both together.
  PB_N          = 8;          // note count
  PB_LEN        = 9;          // length in beats
  PB_TEMPO      = 10;
  PB_TSNUM      = 11;
  PB_TSDEN      = 12;
  PB_NMARK      = 13;         // marker count
  PB_NAMELEN    = 14;         // name length in bytes
  PB_MARK       = 64;         // MAX_MARKERS marker positions
  PB_NAME       = 320;        // NAME_MAX character codes
  PB_NOTES      = 512;        // note records, NOTE_STRIDE each
  NAME_MAX      = 128;

  CURHDR        = 384000;     // .. 384512; markers as the phrase carried them:
  MARKERS_OG    = CURHDR + PB_MARK;
  STAGE         = 430000;     // .. 594352

  // ---- gmem mailbox (options:gmem=Midular) ---------------------------------
  // The importer writes a phrase block, sets G_STATE to 2 and puts G_TICKET on
  // one instance's Import Ticket slider.  That instance - and only that one -
  // copies it, sets G_STATE to 3 and echoes the ticket in G_ACK.
  G_MAGIC       = 0;          // MD_MAGIC when the mailbox holds a phrase
  G_PROTO       = 1;          // mailbox layout version, GM_PROTO
  G_STATE       = 2;          // 0 idle, 1 being written, 2 ready, 3 taken
  G_TICKET      = 3;
  G_ACK         = 4;
  GM_PROTO      = 1;

  md_rng        = 12345;
);

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------
function md_clamp(x, lo, hi) ( x < lo ? lo : (x > hi ? hi : x) );

// Park-Miller LCG whose state lives in memory so every voice/grain can own one.
//
// The modulo is done in floating point on purpose.  EEL2's % truncates its
// operands to (at most) 32-bit integers, but state * 16807 needs ~46 bits, so
// `%` collapses the generator into a 3-value cycle.  Every intermediate here is
// an integer below 2^53, so the double arithmetic is exact.
function md_wrap_int(x, m) ( x - floor(x / m) * m );

function md_rndm(p)
(
  (p[0] < 1 || p[0] >= 2147483647) ? p[0] = 1 + md_wrap_int(floor(abs(p[0])), 2147483646);
  p[0] = md_wrap_int(p[0] * 16807, 2147483647);
  p[0] * 0.0000000004656612875;
);

function md_rnd_bi(p) ( md_rndm(p) * 2 - 1 );

// ---------------------------------------------------------------------------
// Sorting (iterative heapsort - EEL2 forbids recursion)
// ---------------------------------------------------------------------------
function md_sift(idx, key, root, n) local(child, tmp)
(
  while (root * 2 + 1 < n) (
    child = root * 2 + 1;
    (child + 1 < n && key[idx[child]] < key[idx[child + 1]]) ? child += 1;
    key[idx[root]] < key[idx[child]] ? (
      tmp = idx[root]; idx[root] = idx[child]; idx[child] = tmp;
      root = child;
    ) : (
      root = n;   // nothing left to do: force the loop to end
    );
  );
);

function md_heapsort(idx, key, n) local(i, tmp)
(
  n > 1 ? (
    i = (n >> 1) - 1;
    while (i >= 0) ( md_sift(idx, key, i, n); i -= 1; );
    i = n - 1;
    while (i > 0) (
      tmp = idx[0]; idx[0] = idx[i]; idx[i] = tmp;
      md_sift(idx, key, 0, i);
      i -= 1;
    );
  );
);

// First index in ord[] whose key is >= pos.  Plain binary search.
function md_find_ev(ord, key, n, pos) local(lo, hi, mid)
(
  lo = 0; hi = n;
  while (lo < hi) (
    mid = (lo + hi) >> 1;
    key[ord[mid]] < pos ? lo = mid + 1 : hi = mid;
  );
  lo;
);

// ---------------------------------------------------------------------------
// Source data
// ---------------------------------------------------------------------------
function md_build_order() local(i, np)
(
  i = 0;
  while (i < md_src_n) (
    np = BUF_NOTES + i * NOTE_STRIDE;
    KEY_FWD[i] = np[0];
    KEY_REV[i] = md_src_len - (np[0] + np[1]);
    ORD_FWD[i] = i;
    ORD_REV[i] = i;
    i += 1;
  );
  md_heapsort(ORD_FWD, KEY_FWD, md_src_n);
  md_heapsort(ORD_REV, KEY_REV, md_src_n);
);

function md_add_note(st, ln, pit, vel, chan) local(np)
(
  md_src_n < MAX_NOTES ? (
    np = BUF_NOTES + md_src_n * NOTE_STRIDE;
    np[0] = st;
    np[1] = max(ln, 0.001);
    np[2] = md_clamp(pit | 0, 0, 127);
    np[3] = md_clamp(vel | 0, 1, 127);
    np[4] = md_clamp(chan | 0, 0, 15);
    md_src_n += 1;
  );
);

// Built-in fallback pattern so the plug-in is usable before anything is imported.
function md_make_default() local(i, p)
(
  md_src_n = 0;
  md_nmark_og = 0;
  md_src_kind = 0;
  md_src_len = 4;
  md_src_tempo = 120;
  md_src_tsnum = 4;
  md_src_tsden = 4;
  strcpy(#md_name, "(built-in pattern)");
  i = 0;
  while (i < 16) (
    p = 60 + (i % 4 == 0 ? 0 : (i % 4 == 1 ? 4 : (i % 4 == 2 ? 7 : 11)));
    md_add_note(i * 0.25, 0.22, p, 100 - (i % 4) * 8, 0);
    i % 4 == 0 ? md_add_note(i * 0.25, 0.45, p - 24, 110, 0);
    i += 1;
  );
  md_build_order();
);

// Fallback for a missing or bogus length: the last note end, rounded up.
function md_len_from_notes() local(i)
(
  md_src_len = 0;
  i = 0;
  while (i < md_src_n) (
    md_src_len = max(md_src_len, BUF_NOTES[i * NOTE_STRIDE] + BUF_NOTES[i * NOTE_STRIDE + 1]);
    i += 1;
  );
  md_src_len = max(ceil(md_src_len), 1);
);

function md_rd(h)
(
  file_avail(h) > 0 ? ( md_rd_ok = 1; file_var(h, md_rd_v); md_rd_v ) : ( md_rd_ok = 0; 0 );
);

// Reads a Midular source file (see docs/FORMAT.md).  Returns 1 on success.
function md_load_handle(h)
  local(magic, ver, cnt, nmark, i, st, ln, pit, vel, chn, ok)
(
  ok = 0;
  h >= 0 ? (
    magic = md_rd(h);
    ver   = md_rd(h);
    (md_rd_ok && magic == MD_MAGIC && ver >= 1 && ver <= MD_FMT_VER) ? (
      md_src_n     = 0;
      md_nmark_og  = 0;
      md_src_len   = md_rd(h);
      cnt          = md_rd(h) | 0;
      md_src_tempo = md_rd(h);
      md_src_tsnum = md_rd(h);
      md_src_tsden = md_rd(h);
      nmark        = md_rd(h) | 0;
      md_rd(h); md_rd(h); md_rd(h); md_rd(h);   // reserved

      md_src_tempo <= 0 ? md_src_tempo = 120;
      md_src_tsnum <= 0 ? md_src_tsnum = 4;
      md_src_tsden <= 0 ? md_src_tsden = 4;

      cnt = md_clamp(cnt, 0, MAX_NOTES);
      i = 0;
      while (i < cnt && md_rd_ok) (
        st  = md_rd(h);
        ln  = md_rd(h);
        pit = md_rd(h);
        vel = md_rd(h);
        chn = md_rd(h);
        md_rd_ok ? md_add_note(st, ln, pit, vel, chn);
        i += 1;
      );

      nmark = md_clamp(nmark, 0, MAX_MARKERS);
      i = 0;
      while (i < nmark && md_rd_ok) (
        st = md_rd(h);
        md_rd_ok ? ( MARKERS_OG[md_nmark_og] = st; md_nmark_og += 1; );
        i += 1;
      );

      md_src_len <= 0 ? md_len_from_notes();
      md_src_n > 0 ? ( md_build_order(); ok = 1; );
    );
  );
  ok;
);

// ---------------------------------------------------------------------------
// Phrase blocks: the importer's mailbox, the project copy, and installing them
// ---------------------------------------------------------------------------

// Mirror the phrase now playing into CURHDR (BUF_NOTES already holds its
// notes), so @serialize can write it the same way whichever source it came from.
function md_sync_cur() local(i, n)
(
  CURHDR[PB_N]     = md_src_n;
  CURHDR[PB_LEN]   = md_src_len;
  CURHDR[PB_TEMPO] = md_src_tempo;
  CURHDR[PB_TSNUM] = md_src_tsnum;
  CURHDR[PB_TSDEN] = md_src_tsden;
  CURHDR[PB_NMARK] = md_nmark_og;
  n = min(strlen(#md_name), NAME_MAX);
  CURHDR[PB_NAMELEN] = n;
  i = 0;
  while (i < n) ( CURHDR[PB_NAME + i] = str_getchar(#md_name, i); i += 1; );
);

// Keep a phrase block's counts inside the buffers they index.
function md_pb_clamp(pb)
(
  pb[PB_N]       = md_clamp(pb[PB_N] | 0, 0, MAX_NOTES);
  pb[PB_NMARK]   = md_clamp(pb[PB_NMARK] | 0, 0, MAX_MARKERS);
  pb[PB_NAMELEN] = md_clamp(pb[PB_NAMELEN] | 0, 0, NAME_MAX);
);

// Install the phrase waiting in STAGE as the playing phrase.  Called from
// @block only: the audio thread is the one reading BUF_NOTES.
function md_install_stage() local(n, i, sp, ok)
(
  ok = 0;
  md_pb_clamp(STAGE);
  n = STAGE[PB_N];
  n > 0 ? (
    md_src_n = 0;
    i = 0;
    while (i < n) (
      sp = STAGE + PB_NOTES + i * NOTE_STRIDE;
      md_add_note(sp[0], sp[1], sp[2], sp[3], sp[4]);
      i += 1;
    );
    md_src_len   = STAGE[PB_LEN];
    md_src_tempo = STAGE[PB_TEMPO] > 0 ? STAGE[PB_TEMPO] : 120;
    md_src_tsnum = STAGE[PB_TSNUM] > 0 ? STAGE[PB_TSNUM] : 4;
    md_src_tsden = STAGE[PB_TSDEN] > 0 ? STAGE[PB_TSDEN] : 4;
    md_src_len <= 0 ? md_len_from_notes();

    md_nmark_og = STAGE[PB_NMARK];
    md_nmark_og > 0 ? memcpy(MARKERS_OG, STAGE + PB_MARK, md_nmark_og);

    strcpy(#md_name, "");
    i = 0;
    while (i < STAGE[PB_NAMELEN]) ( str_setchar(#md_name, i, STAGE[PB_NAME + i]); i += 1; );
    strlen(#md_name) < 1 ? strcpy(#md_name, "(imported phrase)");

    md_build_order();
    md_src_kind = 2;
    md_sync_cur();
    ok = 1;
  );
  ok;
);

// Live markers: the user's edits if there are any, else the phrase's own.
function md_apply_markers()
(
  md_mark_edited ? (
    md_nmark = md_clamp(md_ser_nmark | 0, 0, MAX_MARKERS);
    md_nmark > 0 ? memcpy(MARKERS, MARKERS_SV, md_nmark);
  ) : (
    md_nmark = md_nmark_og;
    md_nmark > 0 ? memcpy(MARKERS, MARKERS_OG, md_nmark);
  );
);

// Check the Import Ticket slider.  A new value is a request from the importer:
// if the gmem mailbox holds a ready phrase addressed with that ticket, copy it
// to STAGE for @block to install, and acknowledge.  Runs from both @slider
// (which fires on TrackFX_SetParam even with no audio running) and @block.
function md_ticket_poll(t) local(n, i, e)
(
  t != md_ticket_seen ? (
    md_ticket_seen = t;
    (t > 0 && gmem[G_MAGIC] == MD_MAGIC && gmem[G_PROTO] == GM_PROTO &&
     gmem[G_STATE] == 2 && gmem[G_TICKET] == t) ? (
      i = PB_N;
      while (i < PB_MARK) ( STAGE[i] = gmem[i]; i += 1; );
      md_pb_clamp(STAGE);
      n = STAGE[PB_NMARK];
      i = 0; while (i < n) ( STAGE[PB_MARK + i] = gmem[PB_MARK + i]; i += 1; );
      n = STAGE[PB_NAMELEN];
      i = 0; while (i < n) ( STAGE[PB_NAME + i] = gmem[PB_NAME + i]; i += 1; );
      e = PB_NOTES + STAGE[PB_N] * NOTE_STRIDE;
      i = PB_NOTES; while (i < e) ( STAGE[i] = gmem[i]; i += 1; );

      gmem[G_STATE] = 3;
      gmem[G_ACK]   = t;
      md_mark_edited = 0;        // a new phrase: edits to the old markers go
      md_stage_ready = 1;
    );
  );
);

// @serialize helper: reads or writes one phrase block (header, markers, name,
// notes) - file_mem works in both directions.
function md_ser_block(pb, notes, reading)
(
  file_mem(0, pb + PB_N, 7);
  reading ? md_pb_clamp(pb);
  pb[PB_NMARK]   > 0 ? file_mem(0, pb + PB_MARK, pb[PB_NMARK]);
  pb[PB_NAMELEN] > 0 ? file_mem(0, pb + PB_NAME, pb[PB_NAMELEN]);
  pb[PB_N]       > 0 ? file_mem(0, notes, pb[PB_N] * NOTE_STRIDE);
);

// ---------------------------------------------------------------------------
// Slice analysis
// ---------------------------------------------------------------------------
function md_slice_push(a, b)
(
  (md_nslices < MAX_SLICES && b - a > 0.000001) ? (
    SLICES[md_nslices * 2]     = a;
    SLICES[md_nslices * 2 + 1] = b;
    md_nslices += 1;
  );
);

// Equal divisions of [a,b].
function md_slice_divisions(a, b, n) local(i, w)
(
  n = md_clamp(n | 0, 1, MAX_SLICES);
  w = (b - a) / n;
  i = 0;
  while (i < n) ( md_slice_push(a + i * w, a + (i + 1) * w); i += 1; );
);

// Fixed musical grid across [a,b]; the final partial slice is kept.
function md_slice_grid(a, b, g) local(t, nx)
(
  g <= 0 ? g = 1;
  t = a;
  while (t < b - 0.000001 && md_nslices < MAX_SLICES) (
    nx = min(t + g, b);
    md_slice_push(t, nx);
    t = nx;
  );
);

// Note onsets, clustered with a tolerance derived from the sensitivity control.
// sens 0   -> coarse (1/4 note cluster, only strong onsets)
// sens 100 -> fine   (every distinct note start becomes a slice)
function md_slice_onsets(a, b, sens) local(i, ni, k, tol, last, nn, minv, vel)
(
  tol  = 0.5 * pow(0.02, sens / 100);          // 0.5 beat .. 0.01 beat
  minv = (1 - sens / 100) * 48;                // ignore quiet notes at low sensitivity
  last = -1000000;
  nn   = 0;
  i    = 0;
  while (i < md_src_n && md_nslices < MAX_SLICES) (
    ni  = ORD_FWD[i];
    k   = KEY_FWD[ni];
    vel = BUF_NOTES[ni * NOTE_STRIDE + 3];
    (k >= a - 0.000001 && k < b - 0.000001 && vel >= minv && k - last > tol) ? (
      nn > 0 ? md_slice_push(last, k) : (k > a + 0.000001 ? md_slice_push(a, k));
      last = k;
      nn  += 1;
    );
    i += 1;
  );
  nn > 0 ? md_slice_push(last, b) : md_slice_push(a, b);
);

// New slice whenever the leading (highest) pitch of an onset group changes.
function md_slice_pitch(a, b, sens)
  local(i, ni, k, p, tol, gstart, gtop, prevtop, last)
(
  tol     = 0.5 * pow(0.02, sens / 100);
  gstart  = -1000000;
  gtop    = -1;
  prevtop = -1000000;
  last    = a;
  i       = 0;
  while (i < md_src_n && md_nslices < MAX_SLICES) (
    ni = ORD_FWD[i];
    k  = KEY_FWD[ni];
    p  = BUF_NOTES[ni * NOTE_STRIDE + 2];
    (k >= a - 0.000001 && k < b - 0.000001) ? (
      (gtop < 0 || k - gstart > tol) ? (
        // the previous onset group is complete - did its leading pitch change?
        (gtop >= 0 && gtop != prevtop) ? (
          gstart > last + 0.000001 ? ( md_slice_push(last, gstart); last = gstart; );
          prevtop = gtop;
        );
        gstart = k;
        gtop   = p;
      ) : (
        gtop = max(gtop, p);
      );
    );
    i += 1;
  );
  (gtop >= 0 && gtop != prevtop && gstart > last + 0.000001) ? ( md_slice_push(last, gstart); last = gstart; );
  md_slice_push(last, b);
  md_nslices == 0 ? md_slice_push(a, b);
);

// User markers (imported with the file or placed in the editor).
function md_slice_markers(a, b) local(i, t, last, n)
(
  // markers are kept sorted by md_marker_add()
  last = a;
  n    = 0;
  i    = 0;
  while (i < md_nmark && md_nslices < MAX_SLICES) (
    t = MARKERS[i];
    (t > a + 0.000001 && t < b - 0.000001) ? ( md_slice_push(last, t); last = t; n += 1; );
    i += 1;
  );
  md_slice_push(last, b);
);

function md_build_slices(a, b, method, div, grid, sens) local(g)
(
  md_nslices = 0;
  b - a < 0.0001 ? b = a + 0.0001;
  method == 0 ? md_slice_divisions(a, b, div) :
  method == 1 ? (
    g = grid == 0 ? 0.125 : grid == 1 ? 0.25 : grid == 2 ? 0.5 :
        grid == 3 ? 1     : grid == 4 ? 2    :
        grid == 5 ? md_src_tsnum * 4 / md_src_tsden :
                    md_src_tsnum * 8 / md_src_tsden;
    md_slice_grid(a, b, g);
  ) :
  method == 2 ? md_slice_onsets(a, b, sens) :
  method == 3 ? md_slice_pitch(a, b, sens) :
                md_slice_markers(a, b);
  md_nslices == 0 ? md_slice_push(a, b);
);

// ---------------------------------------------------------------------------
// Marker editing (used by the UI, persisted through @serialize)
// ---------------------------------------------------------------------------
function md_marker_add(t) local(i, j)
(
  md_nmark < MAX_MARKERS ? (
    i = 0;
    while (i < md_nmark && MARKERS[i] < t) ( i += 1; );
    j = md_nmark;
    while (j > i) ( MARKERS[j] = MARKERS[j - 1]; j -= 1; );
    MARKERS[i] = t;
    md_nmark += 1;
  );
);

function md_marker_remove_near(t, tol) local(i, best, bd, d)
(
  best = -1; bd = tol;
  i = 0;
  while (i < md_nmark) (
    d = abs(MARKERS[i] - t);
    d < bd ? ( bd = d; best = i; );
    i += 1;
  );
  best >= 0 ? (
    while (best < md_nmark - 1) ( MARKERS[best] = MARKERS[best + 1]; best += 1; );
    md_nmark -= 1;
    1;
  ) : 0;
);
